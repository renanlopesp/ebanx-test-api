{
   "compilerOptions": {
      "target": "ES2024",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "noUncheckedIndexedAccess": true,
      "verbatimModuleSyntax": true,
      "erasableSyntaxOnly": true,
      "rewriteRelativeImportExtensions": true,
      "noEmit": true,
      "skipLibCheck": true,
      "types": ["node"]
   },
   "include": ["src/**/*.ts", "test/**/*.ts"]
}
